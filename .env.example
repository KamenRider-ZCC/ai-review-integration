# AI评标后端基础地址。使用相对地址时由Vite开发代理转发。
VITE_AI_REVIEW_API_BASE=/ai-review-api/v1

# 公司内独立开发默认启用前端Mock；连接真实后端时改为false。
VITE_USE_MOCK=true

# 仅VITE_USE_MOCK=false且使用相对API地址时生效。
VITE_API_PROXY_TARGET=

# 允许承载Loader的宿主来源，逗号分隔。生产环境必须显式配置。
VITE_ALLOWED_PARENT_ORIGINS=http://127.0.0.1:4176,http://localhost:4176
